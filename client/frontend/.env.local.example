# EurekaX Client — Environment Variables
# ─────────────────────────────────────────────────────
# This file is loaded by Next.js automatically.
# Copy .env.client here and rename to .env.local
# DO NOT commit .env.local to git.

# Server IP on your LAN (update this to match your server's IP)
NEXT_PUBLIC_SERVER_IP=192.168.1.100

# API base URL (used in frontend code)
NEXT_PUBLIC_API_BASE=https://192.168.1.100/api

# WebSocket base URL (for real-time features)
NEXT_PUBLIC_WS_BASE=wss://192.168.1.100/ws

# App name (displayed in UI)
NEXT_PUBLIC_APP_NAME=EurekaX

# Internal (not exposed to browser)
SERVER_API_PORT=8000
